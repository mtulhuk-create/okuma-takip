generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum NameDisplay {
  ENTERED // kullanıcının girdiği ad soyad
  ACCOUNT // hesaptan (Google / e-posta) gelen ad
  BOTH // ikisinin ilk kelimeleri birlikte
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
  KICKED
}

enum PenaltyMode {
  FIXED // gün başına sabit tutar
  PER_PAGE // eksik sayfa başına tutar
}

enum PenaltyStatus {
  UNPAID
  IN_DUE
  PAID
  WAIVED
}

enum DueStatus {
  PENDING // ödeme bekleniyor
  SUBMITTED // üye "ödedim" dedi, admin onayı bekleniyor
  CONFIRMED // admin onayladı
  OVERDUE // vade geçti, yöneticinin kararı bekleniyor (ek süre / indirim / çıkarma)
  EXPIRED // vade geçti, üye gruptan atıldı
  CANCELLED
}

enum ChatPolicy {
  ALL // tüm üyeler yazabilir
  ADMINS // yalnızca yöneticiler yazabilir
}

enum MessageKind {
  TEXT
  DAY // her okuma günü için otomatik gün kartı
  POLL
  BADGE // rozet kartı (oylama / kazanıldı / kalktı)
  IMAGE // fotoğraf (dosya Cloudinary'de; burada yalnızca adresi)
}

enum KefaretStatus {
  ACTIVE
  DONE // tüm günler okundu ya da indirim yapılacak borç kalmadı
  CANCELLED
}

enum BadgeKind {
  GOOD // 7 gün üst üste tam okuma: "Maşallah"
  BAD // 7 gün üst üste tam okuyamama: adı üyelerin oylamasıyla belirlenir
}

enum BadgeStatus {
  VOTING
  ACTIVE
  ENDED // otomatik ya da yönetici tarafından kaldırıldı
  CANCELLED // oylamada şık önerilmedi / rozetler kapatıldı
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id            String   @id // Clerk user id
  username      String?  @unique
  name          String // ad soyad (kullanıcının girdiği)
  accountName   String? // hesaptan (Google/e-posta) gelen ad
  nameConfirmed Boolean  @default(false) // kullanıcı ad soyadını onayladı mı
  liteApp       Boolean  @default(false) // mobil uygulamanın Lite sürümünü kullanıyor (yönetici yapılamaz)
  email         String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships       GroupMember[]
  teamChanges       TeamChangeRequest[]
  ownedGroups       Group[]             @relation("GroupOwner")
  readingLogs       ReadingLog[]
  penalties         Penalty[]
  dues              PaymentDue[]
  invitesReceived   Invitation[]        @relation("Invitee")
  invitesSent       Invitation[]        @relation("Inviter")
  joinRequests      JoinRequest[]
  pushSubscriptions PushSubscription[]
  pushDevices       PushDevice[]
  notifications     Notification[]
  messages          Message[]
  reactions         MessageReaction[]
  pollVotes         PollVote[]
  bookLinks         BookLink[]
  badges            Badge[]
  kefaretPlans      KefaretPlan[]
  badgeOptions      BadgeOption[]
  badgeVotes        BadgeVote[]
  kaza              Kaza?

  @@index([name])
}

model Group {
  id             String      @id @default(cuid())
  name           String
  description    String?
  visibility     Visibility  @default(PRIVATE)
  ownerId        String
  owner          User        @relation("GroupOwner", fields: [ownerId], references: [id])
  // Okuma kuralları
  // Okuma kuralları (ekipler kapalıyken tüm grup için geçerli)
  penaltyMode    PenaltyMode @default(FIXED)
  targetPages    Int         @default(20) // günlük okuma hedefi
  minPages       Int         @default(10) // alt sınır
  penaltyAmount  Int         @default(20) // TL (sabit) ya da eksik sayfa başına TL
  minDiscount    Int         @default(50) // alt sınırı okuyanlara cezada % indirim (sabit cezada)
  books          Json        @default("[]") // okunacak eserler: [{id, title, targetPages, minPages}]
  teamsEnabled   Boolean     @default(false)
  shareProgress  Boolean     @default(false) // üyeler birbirinin okuma geçmişini görebilir
  iban           String      @default("")
  ibanName       String      @default("")
  // Zamanlama (yerel saat, gece yarısından itibaren dakika)
  startMinute    Int         @default(0) // yeni okuma gününün başlangıcı
  deadlineMinute Int         @default(1439) // son bildirim saati
  reminderHours  Int         @default(2) // son saatten kaç saat önce uyarı
  tzOffset       Int         @default(180) // dakika, Türkiye = UTC+3
  chatPolicy     ChatPolicy  @default(ALL)
  dueOffsetDays  Int         @default(0) // varsayılan ödeme vadesi: ay sonundan kaç gün önce (-) / sonra (+)
  kickOnExpire   Boolean     @default(true) // vadesinde ödemeyen (yönetici kararından sonra) gruptan çıkarılır
  nameDisplay    NameDisplay @default(ENTERED) // grupta okuyucuların adı nasıl görünsün
  badgesEnabled  Boolean     @default(false) // latife rozetleri (yönetici uyarıyı onaylayarak açar)
  badgesSince    String? // rozetler açıldığında kapanmış son gün; seriler sonraki günlerden sayılır
  streaksEnabled Boolean     @default(true) // seri rozetleri (3+ gün okuma, tam seri)
  framesEnabled  Boolean     @default(true) // ekip hiyerarşisi çerçeveleri (altın / gümüş / bronz)
  dayDetails     Boolean     @default(true) // gün kartında kim okudu / alt sınır / okumadı; kapalıyken yalnızca bildirdi / bildirmedi
  lastSettledDay String? // ceza hesaplaması yapılan son okuma günü (YYYY-MM-DD)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  members      GroupMember[]
  readingLogs  ReadingLog[]
  penalties    Penalty[]
  dues         PaymentDue[]
  invitations  Invitation[]
  joinRequests JoinRequest[]
  messages     Message[]
  teams        Team[]
  events       GroupEvent[]
  teamChanges  TeamChangeRequest[]
  badges       Badge[]
  kefaretPlans KefaretPlan[]

  @@index([visibility])
}

model GroupMember {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole   @default(MEMBER)
  status     MemberStatus @default(ACTIVE)
  teamId     String?
  team       Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  joinedAt   DateTime     @default(now())
  leftAt     DateTime?
  lastReadAt DateTime? // sohbeti en son okuduğu an (okundu tikleri ve okunmamış sayısı)

  @@unique([groupId, userId])
  @@index([userId, status])
}

model ReadingLog {
  id            String   @id @default(cuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey        String // okuma günü (YYYY-MM-DD)
  pages         Int
  requiredPages Int // o günkü hedef
  minPages      Int      @default(0) // o günkü alt sınır
  books         Json? // eser bazında: [{id, title, pages, target, min}]
  kefaret       Int      @default(0) // kefaret okumasıyla hedefin üstüne okunan ek sayfa
  kefaretPlanId String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, userId, dayKey])
  @@index([groupId, dayKey])
  // Gün kartında kefaret okunan günler
  @@index([kefaretPlanId])
}

model Penalty {
  id             String        @id @default(cuid())
  groupId        String
  group          Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey         String
  amount         Int // TL
  originalAmount Int? // indirim yapıldıysa ilk tutar
  pagesRead      Int
  requiredPages  Int
  status         PenaltyStatus @default(UNPAID)
  dueId          String?
  due            PaymentDue?   @relation(fields: [dueId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([groupId, userId, dayKey])
  @@index([groupId, userId, status])
}

model PaymentDue {
  id            String    @id @default(cuid())
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  dueAt         DateTime
  originalDueAt DateTime? // ek süre verildiyse ilk vade
  extensions    Int       @default(0) // kaç kez ek süre verildi
  decisionUntil DateTime? // vade dolunca yöneticinin karar vermesi için son an
  status        DueStatus @default(PENDING)
  paymentNote   String? // üyenin dekont/açıklama notu
  submittedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  penalties Penalty[]

  @@index([status, dueAt])
  @@index([groupId, userId])
}

model Invitation {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User          @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User          @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([inviteeId, status])
}

model JoinRequest {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String? // ekipli gruplarda seçilen ekip
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([groupId, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // Bildirim gönderiminde kişinin abonelikleri
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Aynı hatırlatmanın iki kez gönderilmesini engeller
model NotificationLog {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  key       String // gün ya da vade id'si
  kind      String // REMINDER, CD10..CD1, DUE24 ...
  createdAt DateTime @default(now())

  @@unique([groupId, userId, key, kind])
  @@index([createdAt])
}

model Message {
  id        String            @id @default(cuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String? // gün kartlarında boş
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      MessageKind       @default(TEXT)
  text      String?
  dayKey    String? // DAY mesajları için okuma günü
  media     String? // IMAGE: Cloudinary adresi (dosya uygulamanın sunucusunda tutulmaz)
  mediaW    Int?
  mediaH    Int?
  replyToId String? // yanıtlanan mesaj (silinirse boşalır)
  replyTo   Message?          @relation("Reply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("Reply")
  createdAt DateTime          @default(now())
  poll      Poll?
  badgeId   String? // BADGE mesajları: text = VOTE | AWARD | END
  badge     Badge?            @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@unique([groupId, kind, dayKey])
  @@index([groupId, createdAt])
}

model Poll {
  id        String       @id @default(cuid())
  messageId String       @unique
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String
  multiple  Boolean      @default(false)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text     String
  position Int
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

model Team {
  id            String              @id @default(cuid())
  groupId       String
  group         Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  position      Int                 @default(0)
  penaltyMode   PenaltyMode         @default(FIXED)
  targetPages   Int                 @default(20)
  minPages      Int                 @default(10)
  penaltyAmount Int                 @default(20)
  minDiscount   Int                 @default(50)
  books         Json                @default("[]")
  members       GroupMember[]
  changes       TeamChangeRequest[]

  @@index([groupId])
}

model TeamChangeRequest {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([groupId, status])
}

// Gerçek zamanlı sohbet olayları (SSE ile istemcilere akar; eski kayıtlar cron ile silinir)
model GroupEvent {
  id        Int      @id @default(autoincrement())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type      String
  payload   String?
  createdAt DateTime @default(now())

  @@index([groupId, id])
  @@index([createdAt])
}

// Kullanıcının iki gruptaki aynı eseri "tek görev" saymasi: birinde işaretlenen sayfa diğerine de yansır
// (hedefi düşük olan grupta hedef kadar). Her bağ iki yönlü kaydedilir.
model BookLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String
  bookId      String
  linkGroupId String
  linkBookId  String
  createdAt   DateTime @default(now())

  @@unique([userId, groupId, bookId, linkGroupId])
  @@index([userId, groupId])
}

/**
 * Gruba özel rozet: o grubun okuma verisine göre verilir ve kaldırılır
 */
model Badge {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      BadgeKind
  status    BadgeStatus
  label     String? // en fazla 2 kelime
  streakDay String // 7 günlük serinin son günü; kaldırma için sonraki günler sayılır
  voteUntil DateTime?
  awardedAt DateTime?
  endedDay  String? // yeni seri bu günden sonra başlar
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  options   BadgeOption[]
  votes     BadgeVote[]
  messages  Message[]

  @@index([groupId, status])
  @@index([groupId, userId])
}

model BadgeOption {
  id        String      @id @default(cuid())
  badgeId   String
  badge     Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  label     String
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  votes     BadgeVote[]

  @@unique([badgeId, authorId])
}

model BadgeVote {
  id       String      @id @default(cuid())
  badgeId  String
  badge    Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  optionId String
  option   BadgeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([badgeId, userId])
}

/**
 * Kefaret okuması: yönetici cezalara indirimi okuma karşılığı verir. Üye her kefaret gününde günlük hedefinin
 * üstüne ek sayfa okur; her tamamlanan gün indirimin bir payını kazandırır. Üye istemezse normal okumaya devam eder.
 */
model KefaretPlan {
  id              String        @id @default(cuid())
  groupId         String
  group           Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById     String
  status          KefaretStatus @default(ACTIVE)
  discountPercent Int // cezalara indirim oranı
  raisePercent    Int // günlük hedefe zam oranı
  penaltyTotal    Int // başlarken ödenmemiş ceza (TL)
  missedPages     Int // bu cezalarda eksik kalan sayfa
  discountTotal   Int // kazanılabilecek toplam indirim (TL)
  pageValue       Float // grup geneli: 1 TL indirim kaç kefaret sayfası
  pages           Int // toplam kefaret sayfası
  dailyExtra      Int // kefaret gününde hedefin üstüne okunacak sayfa
  days            Int // gereken kefaret günü
  doneDays        Int           @default(0)
  earned          Int           @default(0) // kazanılıp cezalardan düşülen TL
  startDay        String // bu günden (dahil) itibaren kefaret okunabilir
  createdAt       DateTime      @default(now())
  endedAt         DateTime?

  @@index([groupId, status])
  @@index([groupId, userId])
}

/**
 * Namaz kaza takibi (kişisel). Varsayılan kapalı; kişi "Kaza namazım var" deyince açılır.
 * remaining/made: { sabah, ogle, ikindi, aksam, yatsi, vitir } kalan ve kılınan sayılar.
 */
model Kaza {
  userId    String    @id
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean   @default(false)
  remaining Json      @default("{}")
  made      Json      @default("{}")
  dailyGoal Int       @default(0) // günlük kaza hedefi (0: yok)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  days      KazaDay[]
}

/**
 * Günlük kılınan kaza sayısı (seri ve son günler grafiği)
 */
model KazaDay {
  userId String
  kaza   Kaza   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  dayKey String // YYYY-MM-DD (Türkiye saati)
  count  Int    @default(0) // kılınan kaza
  added  Int    @default(0) // o gün kaçırılıp kazaya eklenen (geçmişte net = kılınan − eklenen)

  @@id([userId, dayKey])
}

/**
 * Mesaja bırakılan ifade: kişi başına mesajda bir ifade (aynısına tekrar basınca kalkar)
 */
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

/// Mobil uygulamanın anlık bildirim (Firebase) cihaz kaydı
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
