generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum NameDisplay {
  ENTERED // kullanıcının girdiği ad soyad
  ACCOUNT // hesaptan (Google / e-posta) gelen ad
  BOTH // ikisinin ilk kelimeleri birlikte
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
  KICKED
}

enum PenaltyMode {
  FIXED // gün başına sabit tutar
  PER_PAGE // eksik sayfa başına tutar
}

enum PenaltyStatus {
  UNPAID
  IN_DUE
  PAID
  WAIVED
}

enum DueStatus {
  PENDING // ödeme bekleniyor
  SUBMITTED // üye "ödedim" dedi, admin onayı bekleniyor
  CONFIRMED // admin onayladı
  OVERDUE // vade geçti, yöneticinin kararı bekleniyor (ek süre / indirim / çıkarma)
  EXPIRED // vade geçti, üye gruptan atıldı
  CANCELLED
}

enum ChatPolicy {
  ALL // tüm üyeler yazabilir
  ADMINS // yalnızca yöneticiler yazabilir
}

enum MessageKind {
  TEXT
  DAY // her okuma günü için otomatik gün kartı
  POLL
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id        String   @id // Clerk user id
  username  String?  @unique
  name      String // ad soyad (kullanıcının girdiği)
  accountName String? // hesaptan (Google/e-posta) gelen ad
  nameConfirmed Boolean @default(false) // kullanıcı ad soyadını onayladı mı
  email     String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       GroupMember[]
  teamChanges       TeamChangeRequest[]
  ownedGroups       Group[]            @relation("GroupOwner")
  readingLogs       ReadingLog[]
  penalties         Penalty[]
  dues              PaymentDue[]
  invitesReceived   Invitation[]       @relation("Invitee")
  invitesSent       Invitation[]       @relation("Inviter")
  joinRequests      JoinRequest[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  messages          Message[]
  pollVotes         PollVote[]
  bookLinks         BookLink[]

  @@index([name])
}

model Group {
  id            String      @id @default(cuid())
  name          String
  description   String?
  visibility    Visibility  @default(PRIVATE)
  ownerId       String
  owner         User        @relation("GroupOwner", fields: [ownerId], references: [id])
  // Okuma kuralları
  // Okuma kuralları (ekipler kapalıyken tüm grup için geçerli)
  penaltyMode   PenaltyMode @default(FIXED)
  targetPages   Int         @default(20) // günlük okuma hedefi
  minPages      Int         @default(10) // alt sınır
  penaltyAmount Int         @default(20) // TL (sabit) ya da eksik sayfa başına TL
  minDiscount   Int         @default(50) // alt sınırı okuyanlara cezada % indirim (sabit cezada)
  books         Json        @default("[]") // okunacak eserler: [{id, title, targetPages, minPages}]
  teamsEnabled  Boolean     @default(false)
  shareProgress Boolean     @default(false) // üyeler birbirinin okuma geçmişini görebilir
  iban          String      @default("")
  ibanName      String      @default("")
  // Zamanlama (yerel saat, gece yarısından itibaren dakika)
  startMinute   Int         @default(0) // yeni okuma gününün başlangıcı
  deadlineMinute Int        @default(1439) // son bildirim saati
  reminderHours Int         @default(2) // son saatten kaç saat önce uyarı
  tzOffset      Int         @default(180) // dakika, Türkiye = UTC+3
  chatPolicy    ChatPolicy  @default(ALL)
  dueOffsetDays Int         @default(0) // varsayılan ödeme vadesi: ay sonundan kaç gün önce (-) / sonra (+)
  kickOnExpire  Boolean     @default(true) // vadesinde ödemeyen (yönetici kararından sonra) gruptan çıkarılır
  nameDisplay   NameDisplay @default(ENTERED) // grupta okuyucuların adı nasıl görünsün
  lastSettledDay String? // ceza hesaplaması yapılan son okuma günü (YYYY-MM-DD)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  members      GroupMember[]
  readingLogs  ReadingLog[]
  penalties    Penalty[]
  dues         PaymentDue[]
  invitations  Invitation[]
  joinRequests JoinRequest[]
  messages     Message[]
  teams        Team[]
  events       GroupEvent[]
  teamChanges  TeamChangeRequest[]

  @@index([visibility])
}

model GroupMember {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole   @default(MEMBER)
  status     MemberStatus @default(ACTIVE)
  teamId     String?
  team       Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  joinedAt   DateTime     @default(now())
  leftAt     DateTime?

  @@unique([groupId, userId])
  @@index([userId, status])
}

model ReadingLog {
  id            String   @id @default(cuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey        String // okuma günü (YYYY-MM-DD)
  pages         Int
  requiredPages Int // o günkü hedef
  minPages      Int      @default(0) // o günkü alt sınır
  books         Json? // eser bazında: [{id, title, pages, target, min}]
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, userId, dayKey])
  @@index([groupId, dayKey])
}

model Penalty {
  id            String        @id @default(cuid())
  groupId       String
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey        String
  amount        Int // TL
  originalAmount Int? // indirim yapıldıysa ilk tutar
  pagesRead     Int
  requiredPages Int
  status        PenaltyStatus @default(UNPAID)
  dueId         String?
  due           PaymentDue?   @relation(fields: [dueId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@unique([groupId, userId, dayKey])
  @@index([groupId, userId, status])
}

model PaymentDue {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  dueAt       DateTime
  originalDueAt DateTime? // ek süre verildiyse ilk vade
  extensions  Int       @default(0) // kaç kez ek süre verildi
  decisionUntil DateTime? // vade dolunca yöneticinin karar vermesi için son an
  status      DueStatus @default(PENDING)
  paymentNote String? // üyenin dekont/açıklama notu
  submittedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  penalties Penalty[]

  @@index([status, dueAt])
  @@index([groupId, userId])
}

model Invitation {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User          @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User          @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([inviteeId, status])
}

model JoinRequest {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String? // ekipli gruplarda seçilen ekip
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([groupId, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Aynı hatırlatmanın iki kez gönderilmesini engeller
model NotificationLog {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  key       String // gün ya da vade id'si
  kind      String // REMINDER, CD10..CD1, DUE24 ...
  createdAt DateTime @default(now())

  @@unique([groupId, userId, key, kind])
  @@index([createdAt])
}

model Message {
  id        String      @id @default(cuid())
  groupId   String
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String? // gün kartlarında boş
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      MessageKind @default(TEXT)
  text      String?
  dayKey    String? // DAY mesajları için okuma günü
  createdAt DateTime    @default(now())
  poll      Poll?

  @@unique([groupId, kind, dayKey])
  @@index([groupId, createdAt])
}

model Poll {
  id        String       @id @default(cuid())
  messageId String       @unique
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String
  multiple  Boolean      @default(false)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text     String
  position Int
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

model Team {
  id            String      @id @default(cuid())
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  position      Int         @default(0)
  penaltyMode   PenaltyMode @default(FIXED)
  targetPages   Int         @default(20)
  minPages      Int         @default(10)
  penaltyAmount Int         @default(20)
  minDiscount   Int         @default(50)
  books         Json        @default("[]")
  members       GroupMember[]
  changes       TeamChangeRequest[]

  @@index([groupId])
}

model TeamChangeRequest {
  id        String        @id @default(cuid())
  groupId   String
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([groupId, status])
}

// Gerçek zamanlı sohbet olayları (SSE ile istemcilere akar; eski kayıtlar cron ile silinir)
model GroupEvent {
  id        Int      @id @default(autoincrement())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type      String
  payload   String?
  createdAt DateTime @default(now())

  @@index([groupId, id])
  @@index([createdAt])
}

// Kullanıcının iki gruptaki aynı eseri "tek görev" saymasi: birinde işaretlenen sayfa diğerine de yansır
// (hedefi düşük olan grupta hedef kadar). Her bağ iki yönlü kaydedilir.
model BookLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String
  bookId      String
  linkGroupId String
  linkBookId  String
  createdAt   DateTime @default(now())

  @@unique([userId, groupId, bookId, linkGroupId])
  @@index([userId, groupId])
}
