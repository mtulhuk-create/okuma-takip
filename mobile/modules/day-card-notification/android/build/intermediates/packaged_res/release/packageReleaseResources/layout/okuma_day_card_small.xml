<?xml version="1.0" encoding="utf-8"?>
<!-- Kilit ekranında duran gün kartı (kapalı hali): başlık, kalan süre ve butonlar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:background="@drawable/okuma_card_bg" android:orientation="vertical" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="5dp" android:paddingBottom="2dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif"
      android:maxLines="1" android:ellipsize="end" android:textColor="@color/okuma_fg" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="6dp"
      android:textColor="@color/okuma_muted" android:textSize="11sp" android:textStyle="bold" />
    <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="@color/okuma_fg" android:textSize="12sp" android:textStyle="bold" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

    <FrameLayout android:id="@+id/btn_kefaret_slot" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
      android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
      <TextView android:id="@+id/btn_kefaret" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="center_vertical"
        android:background="@drawable/okuma_btn_kefaret" android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/btn_kefaret_top" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:background="@drawable/okuma_notch_kefaret" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_kefaret" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
      <TextView android:id="@+id/btn_kefaret_bot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:background="@drawable/okuma_notch_none" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_none" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
    <FrameLayout android:id="@+id/btn_read_slot" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
      android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
      <TextView android:id="@+id/btn_read" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="center_vertical"
        android:background="@drawable/okuma_btn_read" android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/btn_read_top" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:background="@drawable/okuma_notch_read" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_read" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
      <TextView android:id="@+id/btn_read_bot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:background="@drawable/okuma_notch_none" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_none" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
    <FrameLayout android:id="@+id/btn_min_slot" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
      android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
      <TextView android:id="@+id/btn_min" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="center_vertical"
        android:background="@drawable/okuma_btn_min" android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/btn_min_top" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:background="@drawable/okuma_notch_min" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_min" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
      <TextView android:id="@+id/btn_min_bot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:background="@drawable/okuma_notch_none" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_none" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
    <FrameLayout android:id="@+id/btn_none_slot" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
      android:layout_marginLeft="2dp" android:layout_marginRight="2dp">
      <TextView android:id="@+id/btn_none" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="center_vertical"
        android:background="@drawable/okuma_btn_none" android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/btn_none_top" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:background="@drawable/okuma_notch_none" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_none" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
      <TextView android:id="@+id/btn_none_bot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:background="@drawable/okuma_notch_none" android:paddingLeft="3dp" android:paddingRight="3dp"
        android:textColor="@color/okuma_none" android:textSize="7.5sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
</LinearLayout>
