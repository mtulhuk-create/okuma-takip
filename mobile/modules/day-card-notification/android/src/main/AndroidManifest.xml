<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <application>
    <receiver android:name="expo.modules.daycard.DayCardReceiver" android:exported="false" />
    <receiver android:name="expo.modules.daycard.DayCardAlarmReceiver" android:exported="false" />
    <receiver android:name="expo.modules.daycard.KazaReceiver" android:exported="false" />
    <receiver android:name="expo.modules.daycard.InboxReceiver" android:exported="false" />
    <receiver android:name="expo.modules.daycard.ChronoReceiver" android:exported="false" />
    <!-- Anlık bildirim: expo-notifications'ın servisi -1 önceliklidir, mesajlar buraya gelir -->
    <service android:name="expo.modules.daycard.PushService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <receiver android:name="expo.modules.daycard.DayCardBootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
