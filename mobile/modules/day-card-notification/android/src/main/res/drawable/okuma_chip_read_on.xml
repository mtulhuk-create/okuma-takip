<!-- Eser butonu (seçili): dolu; basılıyken koyulaşır -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/okuma_read_dark" />
      <stroke android:width="1.5dp" android:color="@color/okuma_read_dark" />
      <corners android:radius="8dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/okuma_read" />
      <stroke android:width="2dp" android:color="@color/okuma_selected_border" />
      <corners android:radius="8dp" />
    </shape>
  </item>
</selector>
