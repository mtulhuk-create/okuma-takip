<!-- Eser butonu (seçili değil): kenar türünün renginde; basılıyken hafif dolgu -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/okuma_min_soft" />
      <stroke android:width="1.5dp" android:color="@color/okuma_min_dark" />
      <corners android:radius="7dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
      <stroke android:width="1.5dp" android:color="@color/okuma_min" />
      <corners android:radius="7dp" />
    </shape>
  </item>
</selector>
