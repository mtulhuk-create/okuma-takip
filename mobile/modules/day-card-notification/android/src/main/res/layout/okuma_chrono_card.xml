<?xml version="1.0" encoding="utf-8"?>
<!-- Kronometre kartı (sistem çerçevesinde, en çok 48dp): solda süre, sağda başlat/durdur ve sıfırla -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingTop="2dp" android:paddingBottom="2dp">
    <Chronometer android:id="@+id/ch_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:includeFontPadding="false" android:maxLines="1" android:fontFeatureSettings="tnum"
      android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/ch_toggle" android:layout_width="wrap_content" android:layout_height="32dp" android:minWidth="84dp" android:gravity="center"
      android:paddingLeft="12dp" android:paddingRight="12dp" android:background="@drawable/okuma_chrono_btn_on" android:includeFontPadding="false"
      android:text="Başlat" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/ch_reset" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="6dp" android:gravity="center"
      android:paddingLeft="12dp" android:paddingRight="12dp" android:background="@drawable/okuma_chrono_btn" android:includeFontPadding="false"
      android:text="Sıfırla" android:textColor="@color/chrono_primary" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
