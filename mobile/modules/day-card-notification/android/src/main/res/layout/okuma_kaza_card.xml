<?xml version="1.0" encoding="utf-8"?>
<!-- Bildirim panelindeki kaza kartı (saydam): başlık, kalan toplam, bugün; vakit butonları kılınca kalandan düşer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
  android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="14dp" android:paddingBottom="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:includeFontPadding="false"
      android:text="Kaza namazları" android:textColor="@color/okuma_fg" android:textSize="13.5sp" android:textStyle="bold" />
    <TextView android:id="@+id/k_total" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp"
      android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="@color/okuma_muted" android:textSize="11sp" />
    <TextView android:id="@+id/k_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
      android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/kaza_primary" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/k_undo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"
      android:background="@drawable/okuma_kaza_undo" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"
      android:includeFontPadding="false" android:text="↶ Geri al" android:textColor="@color/okuma_muted" android:textSize="10.5sp" android:textStyle="bold" android:visibility="gone" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/okuma_card_border" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginLeft="-3dp" android:layout_marginRight="-3dp"
    android:orientation="horizontal">
    <LinearLayout android:id="@+id/kb_sabah" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
      android:background="@drawable/okuma_kaza_btn_sabah" android:gravity="center" android:orientation="vertical" android:contentDescription="Sabah kazası kıldım">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
        android:text="Sabah" android:textColor="@color/kaza_sabah" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/kc_sabah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="@color/okuma_fg" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kb_ogle" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
      android:background="@drawable/okuma_kaza_btn_ogle" android:gravity="center" android:orientation="vertical" android:contentDescription="Öğle kazası kıldım">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
        android:text="Öğle" android:textColor="@color/kaza_ogle" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/kc_ogle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="@color/okuma_fg" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kb_ikindi" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
      android:background="@drawable/okuma_kaza_btn_ikindi" android:gravity="center" android:orientation="vertical" android:contentDescription="İkindi kazası kıldım">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
        android:text="İkindi" android:textColor="@color/kaza_ikindi" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/kc_ikindi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="@color/okuma_fg" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kb_aksam" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
      android:background="@drawable/okuma_kaza_btn_aksam" android:gravity="center" android:orientation="vertical" android:contentDescription="Akşam kazası kıldım">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
        android:text="Akşam" android:textColor="@color/kaza_aksam" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/kc_aksam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="@color/okuma_fg" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kb_yatsi" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
      android:background="@drawable/okuma_kaza_btn_yatsi" android:gravity="center" android:orientation="vertical" android:contentDescription="Yatsı kazası kıldım">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
        android:text="Yatsı" android:textColor="@color/kaza_yatsi" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/kc_yatsi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="@color/okuma_fg" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kb_vitir" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
      android:background="@drawable/okuma_kaza_btn_vitir" android:gravity="center" android:orientation="vertical" android:contentDescription="Vitir kazası kıldım">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1"
        android:text="Vitir" android:textColor="@color/kaza_vitir" android:textSize="10sp" android:textStyle="bold" />
      <TextView android:id="@+id/kc_vitir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:includeFontPadding="false" android:maxLines="1"
        android:textColor="@color/okuma_fg" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
