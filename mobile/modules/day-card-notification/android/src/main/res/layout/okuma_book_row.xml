<?xml version="1.0" encoding="utf-8"?>
<!-- Açık kartta bir eser: üstte ince çizgi; adı, hedef bilgisi ve geniş butonlar (sağ üst çentik sayfa, sağ alt ceza) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp">
  <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/okuma_card_border" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="6dp" android:paddingBottom="0dp">
    <TextView android:id="@+id/book_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="0dp" android:paddingRight="0dp"
      android:maxLines="1" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="13.5sp" android:textStyle="bold" />
    <TextView android:id="@+id/book_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:paddingLeft="0dp" android:paddingRight="0dp"
      android:maxLines="1" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
      <FrameLayout android:id="@+id/c_kefaret" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp">
        <LinearLayout android:id="@+id/b_kefaret" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
          android:background="@drawable/okuma_chip_kefaret" android:gravity="center" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp"
          android:contentDescription="Kefaret okuması">
          <ImageView android:id="@+id/i_kefaret" android:layout_width="14dp" android:layout_height="14dp" android:scaleType="fitCenter" android:src="@drawable/okuma_ic_kefaret" />
          <TextView android:id="@+id/l_kefaret" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:maxLines="1"
            android:text="Kefaret" android:textColor="@color/okuma_kefaret" android:textSize="10.5sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/n_kefaret" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|right" android:layout_marginRight="6dp"
          android:background="@drawable/okuma_notch_kefaret" android:paddingLeft="4dp" android:paddingRight="4dp" android:includeFontPadding="false"
          android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
      </FrameLayout>
      <FrameLayout android:id="@+id/c_read" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp">
        <LinearLayout android:id="@+id/b_read" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
          android:background="@drawable/okuma_chip_read" android:gravity="center" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp"
          android:contentDescription="Okudum">
          <ImageView android:id="@+id/i_read" android:layout_width="14dp" android:layout_height="14dp" android:scaleType="fitCenter" android:src="@drawable/okuma_ic_read" />
          <TextView android:id="@+id/l_read" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:maxLines="1"
            android:text="Okudum" android:textColor="@color/okuma_read" android:textSize="10.5sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/n_read" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|right" android:layout_marginRight="6dp"
          android:background="@drawable/okuma_notch_read" android:paddingLeft="4dp" android:paddingRight="4dp" android:includeFontPadding="false"
          android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
      </FrameLayout>
      <FrameLayout android:id="@+id/c_min" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp">
        <LinearLayout android:id="@+id/b_min" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
          android:background="@drawable/okuma_chip_min" android:gravity="center" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp"
          android:contentDescription="Alt sınırı okudum">
          <ImageView android:id="@+id/i_min" android:layout_width="14dp" android:layout_height="14dp" android:scaleType="fitCenter" android:src="@drawable/okuma_ic_min" />
          <TextView android:id="@+id/l_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:maxLines="1"
            android:text="Alt sınır" android:textColor="@color/okuma_min" android:textSize="10.5sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/n_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|right" android:layout_marginRight="6dp"
          android:background="@drawable/okuma_notch_min" android:paddingLeft="4dp" android:paddingRight="4dp" android:includeFontPadding="false"
          android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/f_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|right" android:layout_marginRight="6dp"
          android:background="@drawable/okuma_notch_none" android:paddingLeft="4dp" android:paddingRight="4dp" android:includeFontPadding="false"
          android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
      </FrameLayout>
      <FrameLayout android:id="@+id/c_none" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp">
        <LinearLayout android:id="@+id/b_none" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
          android:background="@drawable/okuma_chip_none" android:gravity="center" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp"
          android:contentDescription="Okumadım">
          <ImageView android:id="@+id/i_none" android:layout_width="14dp" android:layout_height="14dp" android:scaleType="fitCenter" android:src="@drawable/okuma_ic_none" />
          <TextView android:id="@+id/l_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:maxLines="1"
            android:text="Okumadım" android:textColor="@color/okuma_none" android:textSize="10.5sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/f_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|right" android:layout_marginRight="6dp"
          android:background="@drawable/okuma_notch_none" android:paddingLeft="4dp" android:paddingRight="4dp" android:includeFontPadding="false"
          android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
